{
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    // "typeRoots": ["./src/types"]
    "typeRoots": ["./node_modules/@types", "./src/types"]   // ← important
  },
  "include": ["src/**/*", "models"],
  "exclude": ["node_modules"]
}
